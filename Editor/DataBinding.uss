.db-inspector {
    padding-top: 2px;
    padding-bottom: 4px;
}
.db-model {
    margin-top: 6px;
    margin-bottom: 8px;
}
.db-model-row {
    flex-direction: row;
    align-items: center;
}
.db-field-label {
    width: 136px;
    flex-shrink: 0;
}
.db-script > .unity-base-field__label {
    min-width: 136px;
    width: 136px;
}
.db-field > .unity-base-field__label {
    min-width: 112px;
    width: 112px;
    flex-shrink: 0;
}
.db-field > .unity-base-field__input {
    min-width: 0;
    flex-shrink: 1;
}
.db-model-button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 50px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.db-model-context {
    margin-top: 3px;
    margin-left: 138px;
    font-size: 11px;
    white-space: normal;
    color: var(--unity-colors-label-text);
    opacity: 0.75;
}
.db-collection {
    margin-top: 8px;
    margin-bottom: 4px;
}
.db-collection-foldout > .unity-foldout__toggle {
    -unity-font-style: bold;
    margin-left: 0;
    margin-right: 28px;
    margin-bottom: 5px;
    min-height: 22px;
}
.db-collection-foldout > .unity-foldout__content {
    margin-left: 0;
    padding-left: 0;
}
.db-empty {
    margin-top: 3px;
    margin-bottom: 3px;
    margin-left: 18px;
    opacity: 0.65;
}
.db-add-binding {
    position: absolute;
    top: 0;
    right: 0;
    width: 24px;
    height: 22px;
    margin-top: 0;
    margin-bottom: 0;
}
.db-binding-row {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 3px;
    margin-bottom: 4px;
    padding-top: 3px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
}
.db-binding-foldout > .unity-foldout__toggle {
    margin-left: 0;
    margin-right: 26px;
    min-height: 20px;
}
.db-binding-foldout > .unity-foldout__toggle > .unity-toggle__input {
    min-width: 0;
    flex-shrink: 1;
}
.db-binding-foldout > .unity-foldout__toggle .unity-toggle__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.db-binding-actions {
    position: absolute;
    top: 3px;
    right: 4px;
    width: 22px;
    height: 20px;
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.db-binding-actions > .unity-text-element {
    flex-grow: 1;
    -unity-text-align: middle-center;
}
.db-binding-foldout > .unity-foldout__content {
    margin-left: 0;
    padding-left: 18px;
}
.db-secondary {
    font-size: 11px;
    opacity: 0.75;
    margin-top: 2px;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.db-field-section {
    -unity-font-style: bold;
    font-size: 11px;
    margin-top: 7px;
    margin-bottom: 3px;
}
.db-binding-foldout .unity-help-box {
    margin-top: 5px;
    margin-bottom: 2px;
}
.db-type-picker {
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
}
.db-section-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
}
.db-type-search {
    flex-shrink: 0;
    margin-bottom: 4px;
}
.db-type-results {
    flex-grow: 1;
    min-height: 80px;
    margin-top: 3px;
    margin-bottom: 5px;
}
.db-type-option {
    padding-top: 5px;
    padding-left: 6px;
    padding-right: 6px;
}
.db-type-option > .unity-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.db-picker-footer {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 4px;
}
.db-flex {
    flex-grow: 1;
}
.db-picker-empty {
    margin-top: 6px;
    margin-bottom: 6px;
}
.db-hidden {
    display: none;
}
